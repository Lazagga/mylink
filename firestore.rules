rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /links/{linkId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.token.email == '030126evan@gmail.com'
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasAll(['title', 'description', 'url', 'icon', 'category', 'createdAt'])
        && request.resource.data.keys().hasOnly(['title', 'description', 'url', 'icon', 'category', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 160
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 2048
        && request.resource.data.url.matches('https?://.+')
        && request.resource.data.icon is string
        && request.resource.data.icon.size() > 0
        && request.resource.data.icon.size() <= 4
        && request.resource.data.category in ['WORK', 'CODE', 'WRITING', 'SOCIAL', 'CONTACT', 'OTHER']
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
