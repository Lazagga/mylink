// Public profile: /links/{linkId}, readable by visitors, writable by Kim Taerang.
// Signed-in profiles: /users/{uid}/links/{linkId}, readable and writable by that user.
// Links require title, description, URL, icon, category, and server-created timestamp.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isPublicOwner() {
      return request.auth != null
        && request.auth.token.email == '030126evan@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validLink() {
      return request.resource.data.keys().hasAll(['title', 'description', 'url', 'icon', 'category', 'createdAt'])
        && request.resource.data.keys().hasOnly(['title', 'description', 'url', 'icon', 'category', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 160
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 2048
        && request.resource.data.url.matches('https?://.+')
        && request.resource.data.icon is string
        && request.resource.data.icon.size() > 0
        && request.resource.data.icon.size() <= 4
        && request.resource.data.category in ['WORK', 'CODE', 'WRITING', 'SOCIAL', 'CONTACT', 'OTHER']
        && request.resource.data.createdAt == request.time;
    }

    match /links/{linkId} {
      allow read: if true;
      allow create: if isPublicOwner() && validLink();
      allow update, delete: if false;
    }

    match /users/{userId}/links/{linkId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validLink();
      allow update, delete: if false;
    }
  }
}
